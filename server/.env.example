PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Local database (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=markethub
DB_USER=postgres
DB_PASSWORD=your-database-password

# Online database (Neon, Render): one connection string. Leave empty locally.
DATABASE_URL=

JWT_SECRET=replace-with-a-long-random-string

# AI shopping assistant
OPENAI_API_KEY=your-openai-key

# Payments: "simulated" for demo, "chapa" for real test payments
PAYMENT_MODE=simulated
CHAPA_SECRET_KEY=your-chapa-test-key